# ScreenSage AI Environment Configuration (NVIDIA Gemma 4 Integration)

# NVIDIA API Configuration
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Server Binding (Localhost only by default for local privacy)
HOST=127.0.0.1
PORT=8000

# Inference Timeout in Seconds
INFERENCE_TIMEOUT_SECONDS=60.0

# Maximum Upload Size in Bytes (default: 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Max Image Dimension for Processing
MAX_IMAGE_DIMENSION=4096

# Pillow Decompression Bomb Limit
MAX_IMAGE_PIXELS=10000000

# Session In-Memory TTL (Seconds)
SESSION_TTL_SECONDS=3600
